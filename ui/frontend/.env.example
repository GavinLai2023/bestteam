# `localhost`, not `127.0.0.1` -- the anonymous share-chat visitor cookie is
# SameSite=Lax, and a browser treats those two hosts as different sites, so a
# mismatch with Vite's own `localhost:5173` dev host stops the cookie from ever
# coming back (see ui/frontend/src/lib/api.ts).
VITE_API_BASE=http://localhost:8000
VITE_WS_BASE=ws://localhost:8000
