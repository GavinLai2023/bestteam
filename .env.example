# Copy this file to .env and fill in your real keys.
# .env is git-ignored and will never be committed.

# Web search (Tavily) — free tier at https://tavily.com
TAVILY_API_KEY=tvly-your-key-here

# LLM providers — set whichever you use with bestteam
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- bestteam UI backend (per-customer deployment) ---

# Long random secret for signing login tokens. REQUIRED in all environments —
# backend refuses to start if left at the default. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
BESTTEAM_SECRET_KEY=change-me-to-a-long-random-value

# Set to "production" to enable additional deployment checks (the SECRET_KEY
# guard is unconditional, not dependent on this setting).
BESTTEAM_ENV=production

# Comma-separated usernames that should be admins (reach the Advanced config
# page and the per-user Memory management page). Reconciled onto users.is_admin
# on startup — this list is the source of truth. Leave empty for no admins.
BESTTEAM_ADMIN_USERS=

# Per-user memory (optional, off by default). Set to a SQLite file path to
# enable the platform remembering end-users across runs; the admin Memory page
# manages it. BESTTEAM_MEMORY_MODEL (optional) enables one extraction LLM call
# per run for semantic/procedural records.
BESTTEAM_MEMORY_DB=
BESTTEAM_MEMORY_MODEL=

# Comma-separated list of allowed frontend origins (no trailing slash).
BESTTEAM_CORS_ORIGINS=https://app.example-customer.com

# --- frontend build args (used by docker-compose for the frontend image) ---
# Public URL of the backend, as reachable from the customer's browser.
VITE_API_BASE=https://api.example-customer.com
VITE_WS_BASE=wss://api.example-customer.com
