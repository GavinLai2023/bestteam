# Copy this file to .env and fill in your real keys.
# .env is git-ignored and will never be committed.

# Web search (Tavily) — free tier at https://tavily.com
TAVILY_API_KEY=tvly-your-key-here

# Local business search (Google Places API, New) — enable "Places API (New)"
# at https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=your-key-here

# LLM providers — set whichever you use with bestteam
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- bestteam UI backend (per-customer deployment) ---

# Long random secret for signing login tokens. REQUIRED in all environments —
# backend refuses to start if left at the default. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
BESTTEAM_SECRET_KEY=change-me-to-a-long-random-value

# Encryption key for at-rest secrets — currently the per-org mailbox passwords
# connected with `admin set-email` or by customers in the wizard (see
# docs/deployment.md). ONE key for the whole deployment, NOT one per customer:
# every org's mailbox password is encrypted with this same key, which you (the
# operator) set once. Customers never see or generate it. Keep it in the
# environment / a secrets manager — NEVER in the database (that would defeat the
# encryption). REQUIRED once any org has stored email credentials: the backend
# refuses to start if it can't decrypt them. A DIFFERENT key from
# BESTTEAM_SECRET_KEY (never reuse a signing key to encrypt). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BESTTEAM_SECRETS_KEY=

# Set to "production" to enable additional deployment checks (the SECRET_KEY
# guard is unconditional, not dependent on this setting).
BESTTEAM_ENV=production

# There is NO public registration: orgs, users, and admins are all
# provisioned with the operator CLI (see docs/deployment.md section 4):
#   docker compose exec backend python -m ui.backend.admin create-org <name>
#   docker compose exec backend python -m ui.backend.admin create-user <username> --org <name>
#   docker compose exec backend python -m ui.backend.admin promote <username>

# Per-user memory (optional, off by default). Set to a SQLite file path to
# enable the platform remembering end-users across runs; the admin Memory page
# manages it. BESTTEAM_MEMORY_MODEL (optional) enables one extraction LLM call
# per run for semantic/procedural records.
BESTTEAM_MEMORY_DB=
BESTTEAM_MEMORY_MODEL=

# Per-user memory retrieval upgrades (all optional, off by default; recall is
# plain BM25 unless these are set — see docs/superpowers/... memory specs).
# Same spec-string convention as the knowledge base's embedding_model/rerank_model
# ("fake:<dim>"/"fake:" for $0 tests, or a real provider/model string).
BESTTEAM_MEMORY_EMBEDDING_MODEL=
BESTTEAM_MEMORY_RECENCY_HALF_LIFE_DAYS=
BESTTEAM_MEMORY_QUERY_EXPANSION_MODEL=
BESTTEAM_MEMORY_QUERY_EXPANSION_COUNT=
BESTTEAM_MEMORY_RERANK_MODEL=
BESTTEAM_MEMORY_RERANK_CANDIDATE_K=
# Bounds/retention (optional): cap the recall scan and prune old episodic rows.
BESTTEAM_MEMORY_RECALL_MAX_CANDIDATES=
BESTTEAM_MEMORY_MAX_EPISODIC_PER_USER=

# Team Builder wizard: self-service knowledge base "smart search" toggle
# (optional, off by default). The wizard's "Your documents" step is
# customer-facing and non-technical -- it never shows model names, just a
# Standard/Enhanced choice. Setting BESTTEAM_KB_DEFAULT_EMBEDDING_MODEL is
# what makes the toggle appear at all (unset = customers never see it);
# Enhanced then builds a `type: hybrid` knowledge base with query expansion,
# and reranking too if BESTTEAM_KB_DEFAULT_RERANK_MODEL is also set. Same
# spec-string convention as the knowledge base's own embedding_model/
# rerank_model ("fake:<dim>"/"fake:" for $0 tests, or a real provider/model
# string) -- requires the matching pip extras (tools-rag, tools-rag-vector,
# and tools-rerank if reranking) to actually be installed. See
# docs/KNOWLEDGE_BASES.md.
BESTTEAM_KB_DEFAULT_EMBEDDING_MODEL=
BESTTEAM_KB_DEFAULT_RERANK_MODEL=

# Email tools (optional, off by default). The agent-facing tools are
# draft-only: they read the one configured mailbox and save reply drafts to
# its Drafts folder — they can never send.
# These configure ONE mailbox for the whole process — the single-org / SDK
# path. For a MULTI-ORG deployment do NOT set them: connect each customer's
# mailbox per-org instead with `admin set-email <org>` (encrypted with
# BESTTEAM_SECRETS_KEY; see docs/deployment.md §4c). The backend REFUSES TO
# START (and create-org refuses a second org) if these are set with more than
# one organization, since one process-wide mailbox can't be shared safely
# across tenants. Only set them on a single-org deployment. Pick ONE backend:
#   graph — Microsoft 365 / Exchange Online. App registration with the
#           Mail.ReadWrite APPLICATION permission; scope it to this single
#           mailbox with an Exchange Application Access Policy.
#   imap  — any generic IMAP server (SSL, port 993 by default).
BESTTEAM_EMAIL_BACKEND=
BESTTEAM_GRAPH_TENANT_ID=
BESTTEAM_GRAPH_CLIENT_ID=
BESTTEAM_GRAPH_CLIENT_SECRET=
BESTTEAM_GRAPH_MAILBOX=support@example-customer.com
BESTTEAM_IMAP_HOST=
BESTTEAM_IMAP_PORT=993
BESTTEAM_IMAP_USER=
BESTTEAM_IMAP_PASSWORD=
# Optional: override the Drafts folder name (auto-detected via SPECIAL-USE).
BESTTEAM_IMAP_DRAFTS=

# Expose the shipped demo workflows in ui/backend/workflows/*.yaml (off by
# default). These are OUR fixtures, not a customer's teams: most use `fake:`
# models that return a hardcoded, convincing-looking answer whatever the
# input, and the `*_live` ones spend real API quota — email_triage_demo_live
# reads the running org's connected mailbox (per-org stored credentials),
# falling back to BESTTEAM_EMAIL_* on a single-org deployment. They carry no
# org_id, so while this is on, EVERY org user on the deployment can see and run
# all of them. Leave it unset in production; set to 1 on a dev or sales-demo box.
# The SDK/CLI (`bestteam run workflow.yaml`) is unaffected either way.
BESTTEAM_DEMO_WORKFLOWS=

# Autonomous email trigger (customer opt-in, per org, in the wizard). The
# poller checks each opted-in org's mailbox for new mail and runs that org's
# deployed email team automatically. All optional:
#   BESTTEAM_TRIGGER_POLL_SECONDS  how often to check (default 120)
#   BESTTEAM_TRIGGER_DAILY_CAP     max automatic runs per org per day (default 50)
#   BESTTEAM_TRIGGERS_DISABLED     set to 1 to pause ALL automatic runs platform-wide
#   BESTTEAM_TRIGGER_BATCH_SIZE    max messages one automatic run handles (default 20)
#   BESTTEAM_TRIGGER_RUN_TIMEOUT_SECONDS  after this long a still-'running' automatic
#                                  run stops blocking the next one (default 1800, min 60)
#   BESTTEAM_TRIGGER_MAX_EVENT_ATTEMPTS  how many times one detected message may be
#                                  handed to a run before it is set aside (default 3,
#                                  min 1). Only infrastructure failures (crash, failed
#                                  dispatch, run timeout) use an attempt -- a message
#                                  the model actually processed and failed on waits
#                                  for a manual retry instead.
BESTTEAM_TRIGGER_POLL_SECONDS=
BESTTEAM_TRIGGER_DAILY_CAP=
BESTTEAM_TRIGGERS_DISABLED=
BESTTEAM_TRIGGER_BATCH_SIZE=
BESTTEAM_TRIGGER_RUN_TIMEOUT_SECONDS=
BESTTEAM_TRIGGER_MAX_EVENT_ATTEMPTS=

# Comma-separated list of allowed frontend origins (no trailing slash).
BESTTEAM_CORS_ORIGINS=https://app.example-customer.com

# --- frontend build args (used by docker-compose for the frontend image) ---
# Public URL of the backend, as reachable from the customer's browser.
VITE_API_BASE=https://api.example-customer.com
VITE_WS_BASE=wss://api.example-customer.com
