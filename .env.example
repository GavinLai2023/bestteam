# Copy this file to .env and fill in your real keys.
# .env is git-ignored and will never be committed.

# Web search (Tavily) — free tier at https://tavily.com
TAVILY_API_KEY=tvly-your-key-here

# LLM providers — set whichever you use with bestteam
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- bestteam UI backend (per-customer deployment) ---

# Long random secret for signing login tokens. REQUIRED in all environments —
# backend refuses to start if left at the default. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
BESTTEAM_SECRET_KEY=change-me-to-a-long-random-value

# Set to "production" to enable additional deployment checks (the SECRET_KEY
# guard is unconditional, not dependent on this setting).
BESTTEAM_ENV=production

# There is NO public registration: orgs, users, and admins are all
# provisioned with the operator CLI (see docs/deployment.md section 4):
#   docker compose exec backend python -m ui.backend.admin create-org <name>
#   docker compose exec backend python -m ui.backend.admin create-user <username> --org <name>
#   docker compose exec backend python -m ui.backend.admin promote <username>

# Per-user memory (optional, off by default). Set to a SQLite file path to
# enable the platform remembering end-users across runs; the admin Memory page
# manages it. BESTTEAM_MEMORY_MODEL (optional) enables one extraction LLM call
# per run for semantic/procedural records.
BESTTEAM_MEMORY_DB=
BESTTEAM_MEMORY_MODEL=

# Email tools (optional, off by default). The agent-facing tools are
# draft-only: they read the one configured mailbox and save reply drafts to
# its Drafts folder — they can never send.
# MULTI-ORG GUARD: these configure ONE mailbox for the whole process, so the
# backend REFUSES TO START (and create-org refuses a second org) when they are
# set on a deployment with more than one organization — otherwise every org's
# agents would share the same mailbox (per-org credentials are a future
# sub-project). Only set them on a single-org deployment. Pick ONE backend:
#   graph — Microsoft 365 / Exchange Online. App registration with the
#           Mail.ReadWrite APPLICATION permission; scope it to this single
#           mailbox with an Exchange Application Access Policy.
#   imap  — any generic IMAP server (SSL, port 993 by default).
BESTTEAM_EMAIL_BACKEND=
BESTTEAM_GRAPH_TENANT_ID=
BESTTEAM_GRAPH_CLIENT_ID=
BESTTEAM_GRAPH_CLIENT_SECRET=
BESTTEAM_GRAPH_MAILBOX=support@example-customer.com
BESTTEAM_IMAP_HOST=
BESTTEAM_IMAP_PORT=993
BESTTEAM_IMAP_USER=
BESTTEAM_IMAP_PASSWORD=
# Optional: override the Drafts folder name (auto-detected via SPECIAL-USE).
BESTTEAM_IMAP_DRAFTS=

# Comma-separated list of allowed frontend origins (no trailing slash).
BESTTEAM_CORS_ORIGINS=https://app.example-customer.com

# --- frontend build args (used by docker-compose for the frontend image) ---
# Public URL of the backend, as reachable from the customer's browser.
VITE_API_BASE=https://api.example-customer.com
VITE_WS_BASE=wss://api.example-customer.com
