# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/

# Logs
*.log

# Claude Code (local session data, machine-specific settings)
.claude/

# Environment variable files (never commit real keys)
.env
.env.local
.env.*.local

# Frontend (also has its own .gitignore, but cover the root view too)
ui/frontend/node_modules/
ui/frontend/dist/

# Stray root-level node_modules (e.g. a frontend tool run from the repo root
# instead of ui/frontend/) -- no root package.json, so this should never be
# tracked (review finding: a machine/run-specific vitest cache landed here).
/node_modules/

# Vector knowledge base embedding caches (generated, machine/run-specific)
.bestteam_cache/

# Per-deployment SQLite database + builder session workspaces (ui/backend)
ui/backend/data/
*.db
