# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/

# Logs
*.log

# Claude Code (local session data, machine-specific settings)
.claude/

# Environment variable files (never commit real keys)
.env
.env.local
.env.*.local

# Frontend (also has its own .gitignore, but cover the root view too)
ui/frontend/node_modules/
ui/frontend/dist/

# Vector knowledge base embedding caches (generated, machine/run-specific)
.bestteam_cache/
